// Refresh obtains a new one-use token, then asks the installed R3 launcher to check and apply.
(()=>{'use strict';const p=window.ttAddPane?.('updates','download','업데이트');if(!p)return;
const s=document.createElement('section');s.className='settings-section';s.innerHTML='<h3>자동 업데이트</h3><label style="display:flex;align-items:center;gap:10px;padding:8px 0;font-weight:700"><input type="checkbox" role="switch" id="ttStartupUpdate" disabled style="width:auto;accent-color:var(--accent)"> 시작할 때 자동 업데이트</label><p class="sub" id="ttStartupUpdateText">설정 확인 중…</p><p class="sub" id="ttPilotStatus" role="status" aria-live="polite">버전 확인 중…</p><p class="sub" id="ttUpdateLast"></p><button type="button" class="accent" id="ttUpdateNow" disabled>↻ 업데이트 확인</button><p class="sub">최신 버전을 확인합니다. 새 버전이 있으면 다운로드·서명 검증 후 대시보드를 자동으로 다시 엽니다. 최신이면 창을 그대로 유지합니다. 수업 중에는 다음 정상 실행 시 자동 확인할 수 있습니다.</p>';p.append(s);
const toggle=s.querySelector('#ttStartupUpdate'),toggleText=s.querySelector('#ttStartupUpdateText');let setting=false;
const b=s.querySelector('#ttUpdateNow'),label=s.querySelector('#ttPilotStatus'),last=s.querySelector('#ttUpdateLast');let timer=0,pending=false,active=false,state=null;
const busy=x=>['checking','installing'].includes(x?.status);
function show(x){state=x;toggle.checked=x.autoStartup===true;toggle.disabled=setting||pending||busy(x)||!x.startupSupported;toggleText.textContent=x.startupSupported?(x.autoStartup?'켜짐 · 시작할 때 최신 버전을 확인하고 필요한 경우 자동 설치합니다.':'꺼짐 · 시작 시 확인하지 않습니다. 아래 수동 확인 버튼은 계속 사용할 수 있습니다.'):'시작 설정을 바꾸려면 실행기 업데이트가 필요합니다.';label.textContent='현재 버전: '+x.current+(x.latest?' · 확인된 버전: '+x.latest:'')+' · '+(x.message||'');const d=new Date(x.checkedAt||'');last.textContent=Number.isFinite(d.getTime())?'마지막 확인: '+d.toLocaleString('ko-KR'):'아직 확인하지 않았습니다.';b.disabled=setting||pending||!x.manualSupported||busy(x);b.textContent=x.status==='installing'?'업데이트 및 재시작 중…':busy(x)||pending?'업데이트 확인 중…':'↻ 업데이트 확인';if(!x.manualSupported)label.textContent+=' · 실행기 업데이트 필요';}
async function status(){const r=await fetch('/api/update/status',{cache:'no-store',credentials:'same-origin'});if(!r.ok)throw Error(r.status);return r.json()}
function later(ms){clearTimeout(timer);timer=setTimeout(poll,ms)}
async function poll(){if(active||pending||setting)return;active=true;try{show(await status());if(busy(state))later(1200)}catch{label.textContent='업데이트 상태 연결 실패. 다시 확인할 수 있습니다.';toggle.disabled=true;b.disabled=false;b.textContent='↻ 업데이트 확인';if(busy(state))later(2400)}finally{active=false}}
b.addEventListener('click',async()=>{if(pending||active||setting||busy(state))return;clearTimeout(timer);pending=true;b.disabled=true;toggle.disabled=true;b.textContent='업데이트 확인 중…';try{const current=await status();if(busy(current)||!current.manualSupported){show(current);return}const r=await fetch('/api/update/apply',{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'X-TT-Update-Token':current.token}});if(!r.ok)throw Error(r.status);show(await r.json())}catch{label.textContent='업데이트 요청을 확인하지 못했습니다. 상태를 다시 확인합니다.'}finally{pending=false;later(500)}});
toggle.addEventListener('change',async()=>{if(setting||pending||active||busy(state)){if(state)show(state);return}const want=toggle.checked;setting=true;toggle.disabled=true;b.disabled=true;clearTimeout(timer);let failed=false;try{const current=await status();if(!current.startupSupported||busy(current)){show(current);return}const r=await fetch('/api/update/auto/'+(want?'on':'off'),{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'X-TT-Update-Token':current.token}});if(!r.ok)throw Error(r.status);const next=await r.json();if(next.autoStartup!==want)throw Error('setting mismatch');show(next)}catch{failed=true;try{show(await status())}catch{if(state)show(state)} }finally{setting=false;if(state)show(state);if(failed)toggleText.textContent='설정을 저장하지 못했습니다. 다시 시도해 주세요.';later(1000)}});
const nav=document.querySelector('.settings-nav');nav?.addEventListener('click',e=>{if(e.target.closest('[data-pane="updates"]'))poll()});poll();})();
