+function getFeedbackBridgeSessionV1(creatorToken){
+  smqFeedbackAuthBridgeAssertTestV1_();
+
+  const token=String(creatorToken||'').trim();
+  let creatorConfirmed=false;
+  let creatorCode='';
+  if(token){
+    try{
+      smqFeedbackCreatorMutationContextV3_(token);
+      creatorConfirmed=true;
+    }catch(err){
+      const raw=String(err&&err.message||err||'').toUpperCase();
+      creatorCode=raw.indexOf('CREATOR_BLOCKED')>=0
